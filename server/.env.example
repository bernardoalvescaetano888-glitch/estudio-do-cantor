# Copie para server/.env e preencha com SUAS credenciais. NUNCA commitar este arquivo!

# Mercado Pago — credencial de PRODUÇÃO (developers.mercadopago.com -> Suas integrações -> Credenciais)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# URL pública do servidor (Render/Railway/etc) — usada nos links de pagamento
WEBHOOK_URL=https://seu-servidor.onrender.com/webhook

# E-mail para enviar as chaves automaticamente
# Gmail: ative 2FA e crie "senha de app" de 16 letras -> https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
